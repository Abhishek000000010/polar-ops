  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@polar-ops/shared": ["../../packages/shared/src/index.ts"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
